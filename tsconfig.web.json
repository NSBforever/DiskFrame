{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/main/usageColor.ts",
    "src/main/validation.ts",
    "src/main/pageCache.ts",
    "src/main/mediaUrl.ts"
  ],
  "compilerOptions": {
    "composite": true,
    // Shared modules under src/main import each other with the real .ts
    // extension so `npm test` can run them unbundled (see tsconfig.node.json).
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ]
    }
  }
}
